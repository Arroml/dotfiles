#!/usr/bin/env bash

set -euo pipefail

PLUGIN_DIR="$CONFIG_DIR/plugins"
WORKSPACES=(a s d f g)

BAR_COLOR=0xff1d2021
ITEM_BG=0xff3c3836
ITEM_BG_VISIBLE=0xff504945
ITEM_BG_FOCUSED=0xffd79921
ITEM_LABEL=0xffebdbb2
ITEM_LABEL_MUTED=0xffa89984
ITEM_ICON=0xfffabd2f

sketchybar --bar \
  height=34 \
  color=$BAR_COLOR \
  corner_radius=12 \
  margin=10 \
  y_offset=8 \
  padding_left=12 \
  padding_right=12 \
  sticky=on \
  topmost=window \
  position=top

sketchybar --default \
  background.height=26 \
  background.corner_radius=8 \
  background.color=$ITEM_BG \
  background.drawing=on \
  icon.font="JetBrainsMono Nerd Font:Bold:13.0" \
  icon.color=$ITEM_ICON \
  icon.padding_left=10 \
  icon.padding_right=8 \
  label.font="JetBrainsMono Nerd Font:Semibold:11.0" \
  label.color=$ITEM_LABEL_MUTED \
  label.padding_left=0 \
  label.padding_right=12 \
  padding_left=4 \
  padding_right=4 \
  updates=when_shown

sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_focus_change

for workspace in "${WORKSPACES[@]}"; do
  item="workspace.${workspace}"

  sketchybar --add item "$item" left \
    --set "$item" \
      icon="$workspace" \
      label="-" \
      click_script="aerospace workspace $workspace" \
      script="$PLUGIN_DIR/aerospace_workspace.sh $workspace" \
      update_freq=10 \
    --subscribe "$item" aerospace_workspace_change aerospace_focus_change front_app_switched
done

sketchybar --add item workspace.spacer left \
  --set workspace.spacer width=8 icon.drawing=off label.drawing=off background.drawing=off

sketchybar --update
